[Unit]
Description=Sanitizer des conversations IA (gdrive:Conv IA)
Documentation=file:///srv/docs/plan.md
After=network-online.target
Wants=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=convia
Group=convia
Environment=HOME=/var/lib/convia
Environment=RCLONE_CONFIG=/var/lib/convia/rclone.conf
Environment=CONVIA_REMOTE=convia:
Environment=CONVIA_STATE=/var/lib/convia
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/var/lib/convia
# verrou partage avec convia-analyse.service : jamais les deux sur le meme corpus
ExecStart=/usr/bin/flock -w 300 /var/lib/convia/convia.lock /usr/bin/python3 /usr/local/bin/convia_sanitize.py
StandardInput=null
TimeoutStartSec=2h
Nice=10

# --- bac a sable : le corpus est une entree hostile (adr/0008)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
ReadWritePaths=/var/lib/convia
ReadOnlyPaths=/opt/convia-sanitize
InaccessiblePaths=/srv/docs /run/docker.sock /var/run/docker.sock

[Install]
WantedBy=multi-user.target
